# Copy to .env.local and fill in. NEVER commit .env.local.

# ---- Supabase ----------------------------------------------------------
# The SAME project the public site uses — that shared database is the only
# thing connecting the two apps. Get these from
# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Bypasses row-level security. Server-side only — never expose it.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ---- The public site ---------------------------------------------------
# Where the blog is deployed, no trailing slash. Publishing pings
# BLOG_URL/api/revalidate so the live site refreshes within seconds instead
# of waiting for its 5-minute timer. Also used to build preview links.
BLOG_URL=https://your-live-blog.vercel.app
# Must match REVALIDATE_SECRET in the blog app. Any long random string.
REVALIDATE_SECRET=change-me-to-a-long-random-string

# ---- AI (free tiers) ---------------------------------------------------
# Groq writes drafts, SEO, FAQs and suggestions.  console.groq.com/keys
GROQ_API_KEY=
# Gemini is the fallback, and generates the embeddings that power
# "related reading" on the blog.  aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: stock photo search in the cover-image picker. pexels.com/api
PEXELS_API_KEY=

# ---- Admin login -------------------------------------------------------
ADMIN_PASSWORD=pick-a-strong-one

# Local development only. Skips the login screen. Hard-guarded so it cannot
# take effect in production, but do not set it on a deployed instance.
# DEV_SKIP_AUTH=1
