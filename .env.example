# Copy to .env.local and fill in. NEVER commit .env.local.

# Postgres 18 + pgvector, connected as the owner.
# Locally, tunnel instead of exposing the port: ssh -i ~/.ssh/<key> -L 5433:<db-ip>:5432 deploy@<server>
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5433/asklys

# The public site. Publishing pings SITE_URL/api/revalidate; also used for preview links.
SITE_URL=https://parent.asklys.com

# Must match the web app. openssl rand -base64 32
REVALIDATE_SECRET=change-me-to-a-long-random-string

# Object storage. Create the key pair with: mc admin accesskey create local/ --name asklys-admin
S3_ENDPOINT=https://s3.asklys.com
S3_PUBLIC_URL=https://s3.asklys.com/media
S3_BUCKET=media
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Groq writes drafts, SEO and FAQs. console.groq.com/keys
GROQ_API_KEY=
# Gemini is the text fallback and the only source of embeddings. aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: stock photo search in the cover picker. pexels.com/api
PEXELS_API_KEY=

# Accounts live in the users table — create one with: node scripts/create-admin.mjs
